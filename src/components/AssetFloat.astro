---
// Displays a single 9:16 image or video without ever cropping or stretching it.
// At desktop widths it's capped at `maxWidth` and centered within whatever grid
// cell it's placed in (a "floated" device-preview size). Below the desktop
// breakpoint the cap is dropped and it fills its column directly.
//
// Video only plays while scrolled into view (see the shared script below) —
// `eager` just controls whether the browser fetches it immediately (for an
// above-the-fold hero) or waits until it's needed (everything else).
interface Props {
  src: string;
  type?: "image" | "video";
  alt?: string;
  poster?: string;
  maxWidth?: string;
  eager?: boolean;
}

const {
  src,
  type,
  alt = "",
  poster,
  maxWidth = "320px",
  eager = false,
} = Astro.props;

const kind = type ?? (/\.(mp4|webm|mov)$/i.test(src) ? "video" : "image");
---

<div class="asset-float" style={`--asset-max-width: ${maxWidth}`}>
	{
		kind === "video" ? (
			<video
				src={src}
				poster={poster}
				muted
				loop
				playsinline
				preload={eager ? "auto" : "none"}
				data-autoplay-in-view
			/>
		) : (
			<img src={src} alt={alt} loading={eager ? "eager" : "lazy"} />
		)
	}
</div>

<style>
	.asset-float {
		display: flex;
		justify-content: center;
	}

	.asset-float img,
	.asset-float video {
		width: 100%;
		aspect-ratio: 9 / 16;
		object-fit: contain;
		background: var(--color-line);
	}

	@media (min-width: 1280px) {
		.asset-float img,
		.asset-float video {
			max-width: var(--asset-max-width);
		}
	}
</style>

<script>
	// Shared across every AssetFloat instance on the page (Astro dedupes
	// identical scripts) — plays each video only while it's in view, and
	// pauses it otherwise, instead of every video autoplaying on page load.
	const videos = document.querySelectorAll<HTMLVideoElement>(
		"video[data-autoplay-in-view]",
	);

	if (videos.length > 0) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const video = entry.target as HTMLVideoElement;
					if (entry.isIntersecting) {
						video.play().catch(() => {});
					} else {
						video.pause();
					}
				}
			},
			{ threshold: 0.25 },
		);

		for (const video of videos) {
			observer.observe(video);
		}
	}
</script>

---
// Displays a single image or video (9:16 by default — most captures are
// vertical phone screens) without ever cropping or stretching it. At desktop
// widths it's capped at `maxWidth` and centered within whatever grid cell
// it's placed in (a "floated" device-preview size). Below the desktop
// breakpoint the cap is dropped and it fills its column directly.
//
// Video only plays while scrolled into view (see the shared script below) —
// `eager` just controls whether the browser fetches it immediately (for an
// above-the-fold hero) or waits until it's needed (everything else).
interface Props {
  src: string;
  type?: "image" | "video";
  alt?: string;
  poster?: string;
  maxWidth?: string;
  // Caps by height instead of width at desktop — for an asset that should
  // visually match the height of a taller/narrower neighbor rather than
  // being capped to a fixed width (e.g. a wider-ratio clip sitting in a
  // sequence of phone-shaped ones).
  maxHeight?: string;
  // Below the desktop breakpoint, a solo asset sized to the shared frame
  // (maxHeight="var(--frame-height)") is drawn at this fraction of its
  // column and left-aligned, matching a <Marquee> slide's own mobileScale
  // so a single frame and a carousel frame on the same page are the same
  // size. Ignored for any other maxHeight (e.g. a deliberate exception).
  mobileScale?: number;
  eager?: boolean;
  aspectRatio?: string;
  // Rounds the asset's corners to read as a device screen, for captures
  // that don't already include their own device frame/bezel.
  rounded?: boolean;
}

const {
  src,
  type,
  alt = "",
  poster,
  maxWidth = "320px",
  maxHeight,
  mobileScale = 0.88,
  eager = false,
  aspectRatio = "9 / 16",
  rounded = false,
} = Astro.props;

const kind = type ?? (/\.(mp4|webm|mov)$/i.test(src) ? "video" : "image");
const frameSized = maxHeight === "var(--frame-height)";

const styleParts = [
  `--asset-max-width: ${maxWidth}`,
  `--asset-aspect-ratio: ${aspectRatio}`,
  `--asset-mobile-scale: ${mobileScale}`,
];
if (maxHeight) styleParts.push(`--asset-max-height: ${maxHeight}`);
---

<div
	class:list={["asset-float", { "has-max-height": !!maxHeight, "frame-sized": frameSized, rounded }]}
	style={styleParts.join("; ")}
>
	{
		kind === "video" ? (
			<video
				src={src}
				poster={poster}
				muted
				loop
				playsinline
				preload={eager ? "auto" : "none"}
				data-autoplay-in-view
			/>
		) : (
			<img src={src} alt={alt} loading={eager ? "eager" : "lazy"} />
		)
	}
</div>

<style>
	.asset-float {
		display: flex;
		justify-content: center;
	}

	.asset-float img,
	.asset-float video {
		width: 100%;
		aspect-ratio: var(--asset-aspect-ratio);
		object-fit: contain;
		background: var(--color-line);
	}

	.asset-float.rounded img,
	.asset-float.rounded video {
		border-radius: 30px;
	}

	@media (max-width: 1279px) {
		.asset-float.frame-sized {
			justify-content: flex-start;
		}

		.asset-float.frame-sized img,
		.asset-float.frame-sized video {
			width: calc(100% * var(--asset-mobile-scale));
		}
	}

	@media (min-width: 1280px) {
		.asset-float img,
		.asset-float video {
			max-width: var(--asset-max-width);
		}

		.asset-float.has-max-height img,
		.asset-float.has-max-height video {
			width: auto;
			max-width: 100%;
			height: var(--asset-max-height);
			max-height: var(--asset-max-height);
		}
	}
</style>

<script>
	import "../scripts/autoplay-in-view";
</script>

---
// The opening of a case study at desktop: the screen is split in two. The
// left half holds the title and summary text, anchored at a fixed distance
// from the top (same on every case study); the right half is a hero video that
// fills that half edge to edge, top to bottom (right up to the top of the page,
// behind the nav, with a fade so "About" stays readable), cropped to cover, with its
// centre always at the centre of the half. Together they fill the first screen
// (the whole viewport), so the page always opens "full screen".
//
// Below the desktop breakpoint there is no hero: just the text.
interface Props {
  src: string;
  poster?: string;
  alt?: string;
}

const { src, poster, alt = "" } = Astro.props;
---

<section class="split">
	<div class="split-text">
		<slot />
	</div>
	<div class="split-media">
		<video
			src={src}
			poster={poster}
			muted
			loop
			playsinline
			preload="auto"
			aria-label={alt}
			data-autoplay-in-view
		></video>
	</div>
</section>

<style>
	/* Mobile: just the text, spaced like the other case-study intros. */
	.split-text {
		padding: var(--space-4) var(--grid-margin) 0;
		margin-bottom: var(--space-5);
	}

	.split-media {
		display: none;
	}

	.split-text :global(h1) {
		font-size: 1.5rem;
		font-weight: 400;
		margin-bottom: 0;
	}

	.split-text :global(h2) {
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.5;
		margin-bottom: 0;
	}

	.split-text :global(p) {
		font-size: 1rem;
		line-height: 1.5;
	}

	@media (min-width: 1280px) {
		/* The split is a full screen, from the very top of the page: it is
		   pulled up behind the nav (--nav-h, plus the --space-5 of padding the
		   article has above it), and the nav (z-index in Nav.astro) sits on
		   top of it. */
		.split {
			display: grid;
			grid-template-columns: 1fr 1fr;
			margin-top: calc(-1 * (var(--nav-h) + var(--space-5)));
			margin-bottom: var(--space-5);
			min-height: max(100svh, 653px);
		}

		/* Left half: aligned to the site's grid margin, anchored at the top
		   (72px, same as the home intro), never centred, so every case study's
		   text starts in the same place. */
		.split-text {
			/* The nav + 72px, so the text starts where it always did. */
			padding: calc(var(--nav-h) + 72px) 60px 0
				max(var(--grid-margin), calc((100vw - var(--grid-container)) / 2 + var(--grid-margin)));
			margin-bottom: 0;
			align-self: start;
		}

		.split-media {
			display: block;
			position: relative;
			overflow: hidden;
			background: var(--color-bg);
		}

		/* A dark fade at the top, so the nav's "About" stays readable where it
		   sits over the video. */
		.split-media::after {
			content: "";
			position: absolute;
			inset: 0 0 auto 0;
			height: 200px;
			background: linear-gradient(
				to bottom,
				rgba(0, 0, 0, 0.75) 0%,
				rgba(0, 0, 0, 0.4) 50%,
				rgba(0, 0, 0, 0) 100%
			);
			pointer-events: none;
		}

		/* Cover: fill the half both ways; crop evenly around the centre. */
		.split-media video {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: 50% 50%;
		}
	}
</style>

<script>
	import "../scripts/autoplay-in-view";
</script>

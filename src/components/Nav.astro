---
import { getEntry } from "astro:content";

const site = (await getEntry("site", "index"))!.data;
const onAbout = Astro.url.pathname.replace(/\/$/, "") === "/about";
---

<header class="nav">
	<div class="page-container nav-inner">
		<a href="/" class="nav-name">{site.name}</a>
		<a href="/about" class:list={["nav-about", { active: onAbout }]} aria-current={onAbout ? "page" : undefined}>About</a>
	</div>
</header>

<style>
	/* Above the page's first block, so a full-screen hero can sit behind it. */
	.nav {
		position: relative;
		z-index: 20;
	}

	.nav-inner {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding-top: var(--space-3);
		font-size: var(--text-l);
		line-height: var(--leading-l);
	}

	@media (min-width: 1280px) {
		.nav-inner {
			padding-top: 65px;
		}
	}

	.nav a {
		text-decoration: none;
	}

	.nav-name,
	.nav-about.active {
		color: var(--color-ink);
	}

	.nav-about {
		color: var(--color-muted);
	}

	.nav-about:hover {
		color: var(--color-ink);
	}
</style>

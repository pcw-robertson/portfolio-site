---
import type { CollectionEntry } from "astro:content";
import AssetFloat from "./AssetFloat.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, context, coverImage, coverVideo } = project.data;
---

<a class="card" href={`/projects/${project.id}`}>
	<div class="card-media">
		{
			coverVideo || coverImage ? (
				<AssetFloat
					src={coverVideo || coverImage!}
					type={coverVideo ? "video" : "image"}
					poster={coverImage}
					maxWidth="220px"
				/>
			) : (
				<div class="card-placeholder" aria-hidden="true" />
			)
		}
	</div>
	<h3>{title}</h3>
	<p class="muted card-context">{context}</p>
</a>

<style>
	.card {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.card-media {
		background: var(--color-line);
		margin-bottom: var(--space-2);
	}

	.card-placeholder {
		width: 100%;
		aspect-ratio: 9 / 16;
		background: var(--color-line);
	}

	.card h3 {
		margin-bottom: 0.25rem;
	}

	.card-context {
		font-size: 0.95rem;
	}
</style>

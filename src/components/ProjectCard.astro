---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, cardTitle, coverImage, coverVideo, cardFit, cardBackground } =
  project.data;
---

<a class="card" href={`/projects/${project.id}`}>
	<div
		class="card-media"
		style={`--card-fit: ${cardFit}${cardBackground ? `; --card-bg: ${cardBackground}` : ""}`}
	>
		{
			coverVideo ? (
				<video
					src={coverVideo}
					poster={coverImage || undefined}
					muted
					loop
					playsinline
					preload="none"
					aria-hidden="true"
					data-autoplay-in-view
				/>
			) : coverImage ? (
				<img src={coverImage} alt="" loading="lazy" />
			) : null
		}
	</div>
	<h3 class="card-title">{cardTitle ?? title}</h3>
</a>

<style>
	.card {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	/* The shape every hero is poured into (530x390 at desktop, the Figma
	   box). `fill` crops the asset to cover the box; `fit` shows all of it
	   centered, on --card-bg, which should match the asset's own background
	   so the box and the media read as one surface. */
	.card-media {
		aspect-ratio: 530 / 390;
		overflow: hidden;
		background: var(--card-bg, #cacaca);
	}

	.card-media video,
	.card-media img {
		display: block;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: var(--card-fit, cover);
	}

	.card-title {
		margin: 17px 0 0;
		font-size: var(--text-l);
		font-weight: 400;
		line-height: var(--leading-l);
		letter-spacing: normal;
		color: var(--color-ink);
	}
</style>

<script>
	import "../scripts/autoplay-in-view";
</script>

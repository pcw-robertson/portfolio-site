---
// A single row of device-shaped assets that scrolls slowly and continuously
// across the full viewport width, looping seamlessly. Every item is drawn at
// the same height (matching the other single-device frames on a page) with
// its width following its own aspect ratio. Videos are muted and looping,
// and only play while visible (shared with AssetFloat).
//
// The set is rendered twice; the track slides left by exactly one set's width
// and restarts, which is visually identical.
//
// Site-wide defaults, so a new case study's gallery matches every other one
// without having to specify any of this per row: `height` defaults to
// `--frame-height` (grid.css) — the shared frame size for a standard
// phone-ratio screen capture, on every page. `shrinkToFit` defaults to on
// for 4 or fewer items, sitting still at that height (see below); more than
// that scrolls. `mobileCarousel` and `autoplay` both default on.
// Every default can still be overridden per row for a deliberate exception
// (a row of wider-than-phone items, a row of stills with nothing to time).
//
// If the whole set fits within the available width (with a side margin
// equal to the gap), it doesn't scroll at all: it sits still, centered,
// with the duplicate copy hidden. Wider viewports get a still row; narrower
// ones scroll — unless `shrinkToFit` is set (or defaulted on), in which
// case it never scrolls at desktop widths: its height scales down (all
// items stay proportional to each other) so the row always fits within the
// page's real grid margins, right down to the mobile breakpoint, instead of
// jumping into a scrolling carousel at some in-between width. Since the
// grid's own content width is capped and doesn't grow past 1280px, this
// height is a single constant across the whole desktop range, not something
// that keeps shrinking as the window narrows.
interface MarqueeItem {
  src: string;
  type?: "image" | "video";
  poster?: string;
  alt?: string;
  aspectRatio?: string;
}

interface Props {
  items: MarqueeItem[];
  // Scroll speed in px per second.
  speed?: number;
  // Scroll left-to-right instead of right-to-left (e.g. for a second stacked
  // row, so two rows read as deliberately contrasting rather than out of sync).
  reverse?: boolean;
  // Desktop height — defaults to the shared site-wide frame size (see above).
  // The mobile default tracks the column width the same way those frames do,
  // scaled down slightly (see mobileScale) so a frame doesn't run edge to
  // edge against the device's own screen.
  height?: string;
  mobileHeight?: string;
  // Fraction of the full mobile column width a frame fills (below 1) — the
  // remainder becomes extra breathing room beyond the grid margin, and a
  // hint of the next item peeking in. Ignored if mobileHeight is set.
  mobileScale?: number;
  radius?: string;
  // Never scroll at desktop widths — shrink instead (see comment above).
  // Defaults to on for 4 items or fewer, off for more — override for a
  // deliberate exception (e.g. wider-than-phone items that won't actually
  // fit 4 across).
  shrinkToFit?: boolean;
  // Below the desktop breakpoint, replace the auto-scrolling row with a
  // swipeable one-at-a-time carousel and dot pagination instead — for
  // content like video where a constant scroll speed fights against each
  // clip's own (different) length. Desktop is unaffected. Defaults on.
  mobileCarousel?: boolean;
  // Auto-advance one slide at a time (mobileCarousel only) — the active dot
  // doubles as a progress bar counting down to the next slide. Pauses
  // whenever the row is scrolled out of view, and a swipe always takes
  // over and restarts the timer from the slide it lands on. Defaults on.
  autoplay?: boolean;
  autoplayMs?: number;
}

const {
  items,
  speed = 20,
  reverse = false,
  height = "var(--frame-height)",
  mobileScale = 0.88,
  mobileHeight = `calc((100vw - 2 * var(--grid-margin)) * ${mobileScale} * 1560 / 720)`,
  radius = "30px",
  shrinkToFit: shrinkToFitProp,
  mobileCarousel = true,
  autoplay = true,
  autoplayMs = 4000,
} = Astro.props;

const shrinkToFit = shrinkToFitProp ?? items.length <= 4;

const kindOf = (item: MarqueeItem) =>
  item.type ?? (/\.(mp4|webm|mov)$/i.test(item.src) ? "video" : "image");
---

<div
	class="marquee full-bleed"
	data-marquee
	data-speed={speed}
	data-reverse={reverse ? "" : undefined}
	data-shrink-to-fit={shrinkToFit ? "" : undefined}
	data-mobile-carousel={mobileCarousel ? "" : undefined}
	data-autoplay={autoplay ? "" : undefined}
	style={`--marquee-height: ${height}; --marquee-height-mobile: ${mobileHeight}; --marquee-radius: ${radius}; --mobile-scale: ${mobileScale}; --autoplay-ms: ${autoplayMs}ms`}
>
	<div class="marquee-track">
		<div class="marquee-set">
			{items.map((item) => (
				<div
					class="marquee-item"
					style={`--item-ratio: ${item.aspectRatio ?? "720 / 1560"}`}
				>
					{kindOf(item) === "video" ? (
						<video
							src={item.src}
							poster={item.poster}
							muted
							loop
							playsinline
							preload="none"
							data-autoplay-in-view
						/>
					) : (
						<img src={item.src} alt={item.alt ?? ""} loading="lazy" />
					)}
				</div>
			))}
			{
				// A trailing clone of the first item, mobileCarousel only — swiping
				// past the real last slide lands here, then an instant (unanimated)
				// jump back to the real first slide makes it read as an endless loop.
				mobileCarousel && items.length > 1 && (
					<div
						class="marquee-item"
						data-loop-clone
						style={`--item-ratio: ${items[0].aspectRatio ?? "720 / 1560"}`}
					>
						{kindOf(items[0]) === "video" ? (
							<video
								src={items[0].src}
								poster={items[0].poster}
								muted
								loop
								playsinline
								preload="none"
								data-autoplay-in-view
							/>
						) : (
							<img src={items[0].src} alt={items[0].alt ?? ""} loading="lazy" />
						)}
					</div>
				)
			}
		</div>
		<div class="marquee-set" aria-hidden="true">
			{items.map((item) => (
				<div
					class="marquee-item"
					style={`--item-ratio: ${item.aspectRatio ?? "720 / 1560"}`}
				>
					{kindOf(item) === "video" ? (
						<video
							src={item.src}
							poster={item.poster}
							muted
							loop
							playsinline
							preload="none"
							data-autoplay-in-view
						/>
					) : (
						<img src={item.src} alt={item.alt ?? ""} loading="lazy" />
					)}
				</div>
			))}
		</div>
	</div>
	{
		mobileCarousel && (
			<div class="marquee-dots" role="tablist" aria-label="Slides">
				{items.map((_, i) => (
					<button
						type="button"
						class="marquee-dot"
						data-dot-index={i}
						aria-label={`Go to slide ${i + 1}`}
					>
						{autoplay && <span class="marquee-dot-fill" />}
					</button>
				))}
			</div>
		)
	}
</div>

<style>
	.marquee {
		overflow: hidden;
	}

	.marquee ~ .marquee {
		margin-top: calc(var(--space-4) * 2);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee-scroll var(--marquee-duration, 60s) linear infinite;
	}

	.marquee[data-reverse] .marquee-track {
		animation-direction: reverse;
	}

	.marquee[data-paused] .marquee-track {
		animation-play-state: paused;
	}

	.marquee[data-static] .marquee-track {
		animation: none;
		margin-inline: auto;
	}

	/* A still row reads as a normal part of the page, so it should align
	   with the same grid margins as everything else — undo the full-bleed
	   breakout (which otherwise measures against the raw viewport instead
	   of the grid's own, capped, centered content width) so it sits back
	   inside its actual .col-12 parent. */
	@media (min-width: 1280px) {
		.marquee[data-static] {
			width: 100%;
			margin-inline: 0;
		}
	}

	.marquee[data-static] .marquee-set {
		padding-right: 0;
	}

	.marquee[data-static] .marquee-set + .marquee-set {
		display: none;
	}

	.marquee-set {
		display: flex;
		flex: none;
		gap: var(--space-4);
		padding-right: var(--space-4);
	}

	.marquee-item {
		flex: none;
		height: var(--marquee-height-mobile);
		aspect-ratio: var(--item-ratio);
		border-radius: var(--marquee-radius);
		overflow: hidden;
		background: var(--color-line);
	}

	.marquee-item :is(img, video) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 1280px) {
		.marquee-item {
			height: var(--marquee-height);
		}

		/* The loop clone only exists for the mobile swipe carousel. */
		.marquee-item[data-loop-clone] {
			display: none;
		}
	}

	@keyframes marquee-scroll {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}

		.marquee {
			overflow-x: auto;
		}
	}

	.marquee-dots {
		display: none;
	}

	/* Swipeable one-at-a-time carousel, below the desktop breakpoint only —
	   see the mobileCarousel prop. Native scroll + snap instead of the
	   animated track, so pace is entirely up to the person swiping. */
	@media (max-width: 1279px) {
		.marquee[data-mobile-carousel] .marquee-track {
			width: 100%;
			animation: none !important;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scroll-padding-inline-start: var(--grid-margin);
			padding-inline: var(--grid-margin);
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
		}

		.marquee[data-mobile-carousel] .marquee-track::-webkit-scrollbar {
			display: none;
		}

		.marquee[data-mobile-carousel] .marquee-set + .marquee-set {
			display: none;
		}

		.marquee[data-mobile-carousel] .marquee-item {
			flex: none;
			width: calc((100vw - 2 * var(--grid-margin)) * var(--mobile-scale));
			height: auto;
			/* Every slide snaps to the same left-aligned spot (the grid margin,
			   via scroll-padding-inline-start above) rather than centering —
			   centering the trailing loop clone can land slightly differently
			   than a real slide since there's nothing after it to center
			   against, which read as a jump when the loop reset. */
			scroll-snap-align: start;
		}

		.marquee[data-mobile-carousel] .marquee-dots {
			display: flex;
			justify-content: center;
			gap: 8px;
			margin-top: var(--space-2);
		}
	}

	.marquee-dot {
		width: 6px;
		height: 6px;
		padding: 0;
		border: none;
		border-radius: 3px;
		background: var(--color-line);
		position: relative;
		overflow: hidden;
		transition: width 0.25s ease, background 0.2s, transform 0.2s;
	}

	.marquee-dot[data-active] {
		background: var(--color-ink);
		transform: scale(1.3);
	}

	/* Autoplay: the active dot elongates into a pill and its fill sweeps
	   left to right over autoplayMs — a progress bar for the next slide. */
	.marquee[data-autoplay] .marquee-dot[data-active] {
		width: 20px;
		background: var(--color-line);
		transform: none;
	}

	.marquee-dot-fill {
		position: absolute;
		inset: 0;
		width: 0%;
		background: var(--color-ink);
		border-radius: inherit;
	}

	.marquee-dot[data-active] .marquee-dot-fill {
		animation: marquee-dot-fill var(--autoplay-ms, 4000ms) linear forwards;
	}

	.marquee[data-paused] .marquee-dot-fill {
		animation-play-state: paused;
	}

	@keyframes marquee-dot-fill {
		from {
			width: 0%;
		}
		to {
			width: 100%;
		}
	}
</style>

<script>
	import "../scripts/autoplay-in-view";

	// Matches the grid system's desktop breakpoint (see grid.css).
	const mobileQuery = window.matchMedia("(max-width: 1279px)");

	const allMarquees = Array.from(
		document.querySelectorAll<HTMLElement>("[data-marquee]"),
	);
	// Every row's own per-frame decision (fits vs. scrolls, at whatever
	// height is currently in force) — run after the shared height below is
	// (re)applied, since that's what the decision depends on.
	const rowUpdaters: Array<() => void> = [];

	// shrinkToFit rows on this page all shrink together, to exactly the
	// same height — the row with the least room to spare sets it for every
	// row, so a page never shows two different frame sizes at once (a
	// six-item scrolling row would otherwise sit at a fixed natural height
	// forever while a four-item row next to it kept shrinking).
	interface ShrinkRow {
		marquee: HTMLElement;
		firstSet: HTMLElement;
		// Sum of each item's own aspect ratio (width/height), captured once
		// from the row's natural (un-shrunk) size — since gaps are a fixed px
		// amount rather than proportional, this is what lets later calls
		// solve directly for "what height makes this row exactly
		// availableWidth wide" instead of just scaling relative to last frame.
		sumOfRatios: number | null;
		naturalHeightPx: number;
	}
	const shrinkRows: ShrinkRow[] = [];

	function measureShrinkRow(row: ShrinkRow) {
		if (row.sumOfRatios !== null) return;
		const items = row.firstSet.querySelectorAll<HTMLElement>(
			".marquee-item:not([data-loop-clone])",
		);
		const gap = parseFloat(getComputedStyle(row.firstSet).columnGap) || 0;
		const contentWidth =
			items[items.length - 1].getBoundingClientRect().right -
			items[0].getBoundingClientRect().left;
		const currentHeight = items[0].getBoundingClientRect().height;
		if (currentHeight > 0) {
			row.sumOfRatios = (contentWidth - (items.length - 1) * gap) / currentHeight;
			row.naturalHeightPx = currentHeight;
		}
	}

	// A row's real available width is its actual grid column's width (e.g.
	// a .col-12's, always exactly the grid's own capped content width) —
	// not the full-bleed marquee's own clientWidth, which tracks the raw
	// viewport and keeps growing past the grid's max-width, and would both
	// mis-size a still row and misalign it against the rest of the page.
	function availableRowWidth(marquee: HTMLElement) {
		return marquee.parentElement!.clientWidth;
	}

	function recomputeSharedHeight() {
		if (mobileQuery.matches || shrinkRows.length === 0) return;
		for (const row of shrinkRows) measureShrinkRow(row);
		const heights = shrinkRows
			.filter((row) => row.sumOfRatios !== null)
			.map((row) => {
				const items = row.firstSet.querySelectorAll<HTMLElement>(
					".marquee-item:not([data-loop-clone])",
				);
				const gap = parseFloat(getComputedStyle(row.firstSet).columnGap) || 0;
				const fitHeight =
					(availableRowWidth(row.marquee) - (items.length - 1) * gap) /
					row.sumOfRatios!;
				return Math.min(row.naturalHeightPx, Math.max(0, fitHeight));
			});
		if (heights.length === 0) return;
		const shared = Math.min(...heights);
		for (const marquee of allMarquees) {
			marquee.style.setProperty("--marquee-height", `${shared}px`);
		}
	}

	function refreshAllRows() {
		recomputeSharedHeight();
		for (const run of rowUpdaters) run();
	}

	for (const marquee of allMarquees) {
		const track = marquee.querySelector<HTMLElement>(".marquee-track")!;
		const speed = Number(marquee.dataset.speed) || 20;
		const shrinkToFit = marquee.hasAttribute("data-shrink-to-fit");
		const mobileCarousel = marquee.hasAttribute("data-mobile-carousel");

		const firstSet = track.querySelector<HTMLElement>(".marquee-set")!;

		let shrinkRow: ShrinkRow | null = null;
		if (shrinkToFit) {
			shrinkRow = { marquee, firstSet, sumOfRatios: null, naturalHeightPx: 0 };
			shrinkRows.push(shrinkRow);
		}

		function update() {
			// The swipe carousel is pure scroll + snap below the breakpoint —
			// none of the scroll/shrink math applies there.
			if (mobileCarousel && mobileQuery.matches) return;

			// A shrinkToFit row's height is set by the shared computation above
			// — by construction that always leaves it fitting.
			if (shrinkToFit) {
				marquee.setAttribute("data-static", "");
				return;
			}

			// The loop clone (mobileCarousel only) is never part of the desktop
			// row's own sizing math.
			const items = firstSet.querySelectorAll<HTMLElement>(
				".marquee-item:not([data-loop-clone])",
			);
			const contentWidth =
				items[items.length - 1].getBoundingClientRect().right -
				items[0].getBoundingClientRect().left;

			const fits = contentWidth <= availableRowWidth(marquee);
			marquee.toggleAttribute("data-static", fits);
			if (!fits) {
				// Duration = one set's width / speed, so the pace stays constant
				// however many items there are or however wide they render.
				const setWidth = track.scrollWidth / 2;
				track.style.setProperty("--marquee-duration", `${setWidth / speed}s`);
			}
		}
		rowUpdaters.push(update);

		const resizeObserver = new ResizeObserver(refreshAllRows);
		resizeObserver.observe(marquee);
		resizeObserver.observe(track);

		const autoplay = marquee.hasAttribute("data-autoplay");
		const autoplayMs = parseFloat(marquee.style.getPropertyValue("--autoplay-ms")) || 4000;
		let inView = true;

		new IntersectionObserver(([entry]) => {
			marquee.toggleAttribute("data-paused", !entry.isIntersecting);
			inView = entry.isIntersecting;
			if (mobileCarousel && autoplay) {
				if (inView) activateCurrentSlide();
				else if (autoplayTimer) clearTimeout(autoplayTimer);
			}
		}).observe(marquee);

		let autoplayTimer: ReturnType<typeof setTimeout> | null = null;
		let activateCurrentSlide: () => void = () => {};

		if (mobileCarousel) {
			// slides = every real item plus the trailing loop clone (if any);
			// realItems excludes the clone — dots and click-to-navigate only
			// ever address real slides.
			const slides = Array.from(
				firstSet.querySelectorAll<HTMLElement>(".marquee-item"),
			);
			const realItems = slides.filter(
				(el) => !el.hasAttribute("data-loop-clone"),
			);
			const dots = Array.from(
				marquee.querySelectorAll<HTMLButtonElement>(".marquee-dot"),
			);

			// Every slide snaps to the same left-aligned spot (see
			// scroll-snap-align: start) — the one closest to that spot,
			// grid-margin in from the track's own left edge, is the active one.
			function marginPx() {
				return (
					parseFloat(
						getComputedStyle(document.documentElement).getPropertyValue(
							"--grid-margin",
						),
					) || 0
				);
			}

			// Returns the index into `slides` (which may point at the clone).
			function closestSlideIndex() {
				const targetLeft = track.getBoundingClientRect().left + marginPx();
				let closest = 0;
				let closestDistance = Infinity;
				slides.forEach((item, i) => {
					const distance = Math.abs(item.getBoundingClientRect().left - targetLeft);
					if (distance < closestDistance) {
						closestDistance = distance;
						closest = i;
					}
				});
				return closest;
			}

			// Cheap, called on every scroll frame while dragging — just keeps
			// the dot highlight tracking the finger. The authoritative update
			// (below) only runs once a swipe actually settles.
			function syncActiveDot() {
				if (!mobileQuery.matches) return;
				const closest = closestSlideIndex() % realItems.length;
				dots.forEach((dot, i) => dot.toggleAttribute("data-active", i === closest));
			}

			// Scrolls the track's own scrollLeft directly rather than calling
			// item.scrollIntoView() — scrollIntoView walks every scrollable
			// ancestor including the window itself, and will drag the whole
			// page's vertical scroll back to wherever this row last was if
			// the row isn't currently "fully visible" (e.g. scrolled off
			// screen, which is expected and fine on pages like this one that
			// reveal/cover this row as part of a larger scroll effect).
			// Setting scrollLeft on the track can never touch window scroll.
			function scrollTrackToItem(item: HTMLElement, behavior: ScrollBehavior) {
				const targetLeft = track.getBoundingClientRect().left + marginPx();
				const delta = item.getBoundingClientRect().left - targetLeft;
				track.scrollTo({ left: track.scrollLeft + delta, behavior });
			}

			function goToRealIndex(i: number) {
				scrollTrackToItem(realItems[i], "smooth");
			}

			// A video's own length if it's loaded, else null — lets a slide's
			// autoplay dwell time (and its dot's fill duration) match however
			// long its own clip actually runs instead of a single guessed
			// value shared by every slide.
			function videoDurationMs(index: number) {
				const video = realItems[index].querySelector("video");
				if (video && isFinite(video.duration) && video.duration > 0) {
					return video.duration * 1000;
				}
				return null;
			}

			let activeIndex = -1;

			// The single point where a slide becomes "current": sets the dot
			// highlight, primes that dot's fill duration to match the slide's
			// own video length (correcting later if metadata wasn't loaded
			// yet), and (re)starts the autoplay timer for exactly that long.
			activateCurrentSlide = () => {
				if (!mobileQuery.matches) return;
				const index = closestSlideIndex() % realItems.length;
				activeIndex = index;
				const knownMs = videoDurationMs(index);
				const ms = knownMs ?? autoplayMs;
				dots.forEach((dot, i) => {
					if (i === index) dot.style.setProperty("--autoplay-ms", `${ms}ms`);
					dot.toggleAttribute("data-active", i === index);
				});

				if (autoplayTimer) clearTimeout(autoplayTimer);
				if (!autoplay || !inView) return;
				autoplayTimer = setTimeout(() => {
					const next = index + 1;
					// Advancing past the real last slide scrolls onto the clone;
					// onSettle below snaps that invisibly back to real index 0.
					scrollTrackToItem(
						next < realItems.length ? realItems[next] : slides[realItems.length],
						"smooth",
					);
				}, ms);

				if (knownMs === null) {
					const video = realItems[index].querySelector("video");
					video?.addEventListener(
						"loadedmetadata",
						() => {
							// Only correct if still sitting on this same slide.
							if (mobileQuery.matches && activeIndex === index) activateCurrentSlide();
						},
						{ once: true },
					);
				}
			};

			// Once a swipe (or an autoplay advance) settles on the trailing
			// clone, jump straight back to the real first slide with no
			// animation — reads as the carousel looping around rather than
			// sliding all the way back.
			let settleTimer: ReturnType<typeof setTimeout> | null = null;
			function onSettle() {
				if (!mobileQuery.matches) return;
				if (closestSlideIndex() === realItems.length) {
					scrollTrackToItem(realItems[0], "auto");
				}
				activateCurrentSlide();
			}

			track.addEventListener(
				"scroll",
				() => {
					requestAnimationFrame(syncActiveDot);
					if (settleTimer) clearTimeout(settleTimer);
					settleTimer = setTimeout(onSettle, 120);
				},
				{ passive: true },
			);
			dots.forEach((dot, i) => {
				dot.addEventListener("click", () => goToRealIndex(i));
			});
			mobileQuery.addEventListener("change", activateCurrentSlide);
			activateCurrentSlide();
		}
	}

	refreshAllRows();
	mobileQuery.addEventListener("change", refreshAllRows);
</script>

---
// A single row of device-shaped assets that scrolls slowly and continuously
// across the full viewport width, looping seamlessly. Every item is drawn at
// the same height (matching the other single-device frames on a page) with
// its width following its own aspect ratio. Videos are muted and looping,
// and only play while visible (shared with AssetFloat).
//
// The set is rendered twice; the track slides left by exactly one set's width
// and restarts, which is visually identical.
//
// If the whole set fits within the viewport (with a side margin equal to the
// gap), it doesn't scroll at all: it sits still, centered, with the duplicate
// copy hidden. Wider viewports get a still row; narrower ones scroll — unless
// `shrinkToFit` is set, in which case it never scrolls at desktop widths: its
// height continuously scales down (all items stay proportional to each
// other) so the row always fits within the page's real grid margins, right
// down to the mobile breakpoint, instead of jumping into a scrolling
// carousel at some in-between width. Use this for a row with few enough
// items that shrinking reads better than scrolling.
interface MarqueeItem {
  src: string;
  type?: "image" | "video";
  poster?: string;
  alt?: string;
  aspectRatio?: string;
}

interface Props {
  items: MarqueeItem[];
  // Scroll speed in px per second.
  speed?: number;
  // Scroll left-to-right instead of right-to-left (e.g. for a second stacked
  // row, so two rows read as deliberately contrasting rather than out of sync).
  reverse?: boolean;
  // Desktop height matches the single-device frames (410px wide at 720:1560).
  // The mobile default tracks the column width the same way those frames do,
  // scaled down slightly (see mobileScale) so a frame doesn't run edge to
  // edge against the device's own screen.
  height?: string;
  mobileHeight?: string;
  // Fraction of the full mobile column width a frame fills (below 1) — the
  // remainder becomes extra breathing room beyond the grid margin, and a
  // hint of the next item peeking in. Ignored if mobileHeight is set.
  mobileScale?: number;
  radius?: string;
  // Never scroll at desktop widths — shrink instead (see comment above).
  shrinkToFit?: boolean;
  // Below the desktop breakpoint, replace the auto-scrolling row with a
  // swipeable one-at-a-time carousel and dot pagination instead — for
  // content like video where a constant scroll speed fights against each
  // clip's own (different) length. Desktop is unaffected.
  mobileCarousel?: boolean;
}

const {
  items,
  speed = 20,
  reverse = false,
  height = "888px",
  mobileScale = 0.88,
  mobileHeight = `calc((100vw - 2 * var(--grid-margin)) * ${mobileScale} * 1560 / 720)`,
  radius = "30px",
  shrinkToFit = false,
  mobileCarousel = false,
} = Astro.props;

const kindOf = (item: MarqueeItem) =>
  item.type ?? (/\.(mp4|webm|mov)$/i.test(item.src) ? "video" : "image");
---

<div
	class="marquee full-bleed"
	data-marquee
	data-speed={speed}
	data-reverse={reverse ? "" : undefined}
	data-shrink-to-fit={shrinkToFit ? "" : undefined}
	data-mobile-carousel={mobileCarousel ? "" : undefined}
	style={`--marquee-height: ${height}; --marquee-height-mobile: ${mobileHeight}; --marquee-radius: ${radius}; --mobile-scale: ${mobileScale}`}
>
	<div class="marquee-track">
		<div class="marquee-set">
			{items.map((item) => (
				<div
					class="marquee-item"
					style={`--item-ratio: ${item.aspectRatio ?? "720 / 1560"}`}
				>
					{kindOf(item) === "video" ? (
						<video
							src={item.src}
							poster={item.poster}
							muted
							loop
							playsinline
							preload="none"
							data-autoplay-in-view
						/>
					) : (
						<img src={item.src} alt={item.alt ?? ""} loading="lazy" />
					)}
				</div>
			))}
			{
				// A trailing clone of the first item, mobileCarousel only — swiping
				// past the real last slide lands here, then an instant (unanimated)
				// jump back to the real first slide makes it read as an endless loop.
				mobileCarousel && items.length > 1 && (
					<div
						class="marquee-item"
						data-loop-clone
						style={`--item-ratio: ${items[0].aspectRatio ?? "720 / 1560"}`}
					>
						{kindOf(items[0]) === "video" ? (
							<video
								src={items[0].src}
								poster={items[0].poster}
								muted
								loop
								playsinline
								preload="none"
								data-autoplay-in-view
							/>
						) : (
							<img src={items[0].src} alt={items[0].alt ?? ""} loading="lazy" />
						)}
					</div>
				)
			}
		</div>
		<div class="marquee-set" aria-hidden="true">
			{items.map((item) => (
				<div
					class="marquee-item"
					style={`--item-ratio: ${item.aspectRatio ?? "720 / 1560"}`}
				>
					{kindOf(item) === "video" ? (
						<video
							src={item.src}
							poster={item.poster}
							muted
							loop
							playsinline
							preload="none"
							data-autoplay-in-view
						/>
					) : (
						<img src={item.src} alt={item.alt ?? ""} loading="lazy" />
					)}
				</div>
			))}
		</div>
	</div>
	{
		mobileCarousel && (
			<div class="marquee-dots" role="tablist" aria-label="Slides">
				{items.map((_, i) => (
					<button
						type="button"
						class="marquee-dot"
						data-dot-index={i}
						aria-label={`Go to slide ${i + 1}`}
					/>
				))}
			</div>
		)
	}
</div>

<style>
	.marquee {
		overflow: hidden;
	}

	.marquee ~ .marquee {
		margin-top: calc(var(--space-4) * 2);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee-scroll var(--marquee-duration, 60s) linear infinite;
	}

	.marquee[data-reverse] .marquee-track {
		animation-direction: reverse;
	}

	.marquee[data-paused] .marquee-track {
		animation-play-state: paused;
	}

	.marquee[data-static] .marquee-track {
		animation: none;
		margin-inline: auto;
	}

	.marquee[data-static] .marquee-set {
		padding-right: 0;
	}

	.marquee[data-static] .marquee-set + .marquee-set {
		display: none;
	}

	.marquee-set {
		display: flex;
		flex: none;
		gap: var(--space-4);
		padding-right: var(--space-4);
	}

	.marquee-item {
		flex: none;
		height: var(--marquee-height-mobile);
		aspect-ratio: var(--item-ratio);
		border-radius: var(--marquee-radius);
		overflow: hidden;
		background: var(--color-line);
	}

	.marquee-item :is(img, video) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 1280px) {
		.marquee-item {
			height: var(--marquee-height);
		}

		/* The loop clone only exists for the mobile swipe carousel. */
		.marquee-item[data-loop-clone] {
			display: none;
		}
	}

	@keyframes marquee-scroll {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}

		.marquee {
			overflow-x: auto;
		}
	}

	.marquee-dots {
		display: none;
	}

	/* Swipeable one-at-a-time carousel, below the desktop breakpoint only —
	   see the mobileCarousel prop. Native scroll + snap instead of the
	   animated track, so pace is entirely up to the person swiping. */
	@media (max-width: 1279px) {
		.marquee[data-mobile-carousel] .marquee-track {
			width: 100%;
			animation: none !important;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: var(--grid-margin);
			padding-inline: var(--grid-margin);
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
		}

		.marquee[data-mobile-carousel] .marquee-track::-webkit-scrollbar {
			display: none;
		}

		.marquee[data-mobile-carousel] .marquee-set + .marquee-set {
			display: none;
		}

		.marquee[data-mobile-carousel] .marquee-item {
			flex: none;
			width: calc((100vw - 2 * var(--grid-margin)) * var(--mobile-scale));
			height: auto;
			scroll-snap-align: center;
		}

		.marquee[data-mobile-carousel] .marquee-dots {
			display: flex;
			justify-content: center;
			gap: 8px;
			margin-top: var(--space-2);
		}
	}

	.marquee-dot {
		width: 6px;
		height: 6px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: var(--color-line);
		transition: background 0.2s, transform 0.2s;
	}

	.marquee-dot[data-active] {
		background: var(--color-ink);
		transform: scale(1.3);
	}
</style>

<script>
	import "../scripts/autoplay-in-view";

	// Matches the grid system's desktop breakpoint (see grid.css).
	const mobileQuery = window.matchMedia("(max-width: 1279px)");

	for (const marquee of document.querySelectorAll<HTMLElement>(
		"[data-marquee]",
	)) {
		const track = marquee.querySelector<HTMLElement>(".marquee-track")!;
		const speed = Number(marquee.dataset.speed) || 20;
		const shrinkToFit = marquee.hasAttribute("data-shrink-to-fit");
		const mobileCarousel = marquee.hasAttribute("data-mobile-carousel");

		const firstSet = track.querySelector<HTMLElement>(".marquee-set")!;

		// For shrinkToFit: sum of each item's own aspect ratio (width/height),
		// captured once from the row's natural (un-shrunk) size — since gaps are
		// a fixed px amount rather than proportional, this is what lets later
		// calls solve directly for "what height makes this row exactly
		// availableWidth wide" instead of just scaling relative to last frame.
		let sumOfRatios: number | null = null;
		let naturalHeightPx = 0;

		function update() {
			// The swipe carousel is pure scroll + snap below the breakpoint —
			// none of the scroll/shrink math applies there.
			if (mobileCarousel && mobileQuery.matches) return;

			// The loop clone (mobileCarousel only) is never part of the desktop
			// row's own sizing math.
			const items = firstSet.querySelectorAll<HTMLElement>(
				".marquee-item:not([data-loop-clone])",
			);
			const gap = parseFloat(getComputedStyle(firstSet).columnGap) || 0;
			const contentWidth =
				items[items.length - 1].getBoundingClientRect().right -
				items[0].getBoundingClientRect().left;

			if (shrinkToFit && !mobileQuery.matches) {
				const currentHeight = items[0].getBoundingClientRect().height;
				if (sumOfRatios === null) {
					// First run, before any shrinking has been applied.
					sumOfRatios = (contentWidth - (items.length - 1) * gap) / currentHeight;
					naturalHeightPx = currentHeight;
				}
				const marginPx =
					parseFloat(
						getComputedStyle(document.documentElement).getPropertyValue(
							"--grid-margin",
						),
					) || 0;
				const availableWidth = marquee.clientWidth - 2 * marginPx;
				const fitHeight =
					(availableWidth - (items.length - 1) * gap) / sumOfRatios;
				const targetHeight = Math.min(naturalHeightPx, Math.max(0, fitHeight));
				marquee.style.setProperty("--marquee-height", `${targetHeight}px`);
				marquee.setAttribute("data-static", "");
				return;
			}

			const fits = contentWidth + 2 * gap <= marquee.clientWidth;
			marquee.toggleAttribute("data-static", fits);
			if (!fits) {
				// Duration = one set's width / speed, so the pace stays constant
				// however many items there are or however wide they render.
				const setWidth = track.scrollWidth / 2;
				track.style.setProperty("--marquee-duration", `${setWidth / speed}s`);
			}
		}

		const resizeObserver = new ResizeObserver(update);
		resizeObserver.observe(marquee);
		resizeObserver.observe(track);
		if (shrinkToFit) mobileQuery.addEventListener("change", update);

		new IntersectionObserver(([entry]) => {
			marquee.toggleAttribute("data-paused", !entry.isIntersecting);
		}).observe(marquee);

		if (mobileCarousel) {
			// slides = every real item plus the trailing loop clone (if any);
			// realItems excludes the clone — dots and click-to-navigate only
			// ever address real slides.
			const slides = Array.from(
				firstSet.querySelectorAll<HTMLElement>(".marquee-item"),
			);
			const realItems = slides.filter(
				(el) => !el.hasAttribute("data-loop-clone"),
			);
			const dots = Array.from(
				marquee.querySelectorAll<HTMLButtonElement>(".marquee-dot"),
			);

			// Returns the index into `slides` (which may point at the clone).
			function closestSlideIndex() {
				const trackCenter =
					track.getBoundingClientRect().left + track.clientWidth / 2;
				let closest = 0;
				let closestDistance = Infinity;
				slides.forEach((item, i) => {
					const rect = item.getBoundingClientRect();
					const distance = Math.abs(rect.left + rect.width / 2 - trackCenter);
					if (distance < closestDistance) {
						closestDistance = distance;
						closest = i;
					}
				});
				return closest;
			}

			function syncActiveDot() {
				if (!mobileQuery.matches) return;
				const closest = closestSlideIndex() % realItems.length;
				dots.forEach((dot, i) => dot.toggleAttribute("data-active", i === closest));
			}

			// Once a swipe settles on the trailing clone, jump straight back to
			// the real first slide with no animation — reads as the carousel
			// looping around rather than sliding all the way back.
			let settleTimer: ReturnType<typeof setTimeout> | null = null;
			function onSettle() {
				if (!mobileQuery.matches) return;
				if (closestSlideIndex() === realItems.length) {
					realItems[0].scrollIntoView({ inline: "center", block: "nearest" });
				}
				syncActiveDot();
			}

			track.addEventListener(
				"scroll",
				() => {
					requestAnimationFrame(syncActiveDot);
					if (settleTimer) clearTimeout(settleTimer);
					settleTimer = setTimeout(onSettle, 120);
				},
				{ passive: true },
			);
			dots.forEach((dot, i) => {
				dot.addEventListener("click", () => {
					realItems[i].scrollIntoView({
						behavior: "smooth",
						inline: "center",
						block: "nearest",
					});
				});
			});
			mobileQuery.addEventListener("change", syncActiveDot);
			syncActiveDot();
		}
	}
</script>

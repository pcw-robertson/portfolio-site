---
// A fixed screen (the phone/browser frame, held static) with a small region
// on it — a result card — that cycles through a sequence of states, each
// one swiping in from the right as the last exits to the left. Built for a
// "you solved it!" style result card where only the headline/illustration
// changes and everything else on screen (nav, browser chrome, whatever's
// below the card) stays put, so it reads as one screen reacting rather than
// a slideshow of full screens.
//
// `cards` are pre-cropped to exactly the card's own region and are
// positioned back on top of `base` at that same spot via the `cardTop` /
// `cardLeft` / `cardWidth` / `cardHeight` percentages (of the base image's
// own dimensions) — get these from the actual pixel crop rectangle you used
// (crop-rect / base-dimensions * 100), not by eye, so every card lines up
// exactly regardless of render size. Only plays its cycle while scrolled
// into view (same gating as video elsewhere on the site).
interface CardItem {
  src: string;
  alt?: string;
}

interface Props {
  base: string;
  baseAlt?: string;
  baseAspectRatio?: string;
  cards: CardItem[];
  cardTop: string;
  cardLeft: string;
  cardWidth: string;
  cardHeight: string;
  intervalMs?: number;
  maxHeight?: string;
  rounded?: boolean;
}

const {
  base,
  baseAlt = "",
  baseAspectRatio = "375 / 812",
  cards,
  cardTop,
  cardLeft,
  cardWidth,
  cardHeight,
  intervalMs = 2800,
  maxHeight = "var(--frame-height)",
  rounded = false,
} = Astro.props;
---

<div class="result-card-swap-wrap">
	<div
		class:list={["result-card-swap", { rounded }]}
		data-result-card-swap
		data-interval={intervalMs}
		style={`--rcs-aspect-ratio: ${baseAspectRatio}; --rcs-max-height: ${maxHeight}; --rcs-card-top: ${cardTop}; --rcs-card-left: ${cardLeft}; --rcs-card-width: ${cardWidth}; --rcs-card-height: ${cardHeight}`}
	>
		<img class="result-card-swap-base" src={base} alt={baseAlt} loading="lazy" />
		<div class="result-card-swap-window">
			{
				cards.map((card, i) => (
					<img
						class="result-card-swap-card"
						data-active={i === 0 ? "" : undefined}
						src={card.src}
						alt={card.alt ?? ""}
						loading="lazy"
					/>
				))
			}
		</div>
	</div>
</div>

<style>
	/* Fills and centers within whatever grid cell this is placed in, same as
	   AssetFloat — .result-card-swap itself shrinks to its own rendered size
	   at desktop (see below), so without this wrapper it sits flush against
	   the column's start edge instead of centered like every other asset. */
	.result-card-swap-wrap {
		display: flex;
		justify-content: center;
		width: 100%;
	}

	.result-card-swap {
		position: relative;
		display: flex;
		justify-content: center;
		width: 100%;
		aspect-ratio: var(--rcs-aspect-ratio);
	}

	.result-card-swap-base {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.result-card-swap.rounded .result-card-swap-base {
		border-radius: 30px;
	}

	.result-card-swap-window {
		position: absolute;
		top: var(--rcs-card-top);
		left: var(--rcs-card-left);
		width: var(--rcs-card-width);
		height: var(--rcs-card-height);
		overflow: hidden;
	}

	.result-card-swap-card {
		position: absolute;
		top: 0;
		left: 100%;
		width: 100%;
		height: 100%;
		object-fit: fill;
		transition: left 0.6s ease;
		pointer-events: none;
	}

	.result-card-swap-card[data-active] {
		left: 0%;
	}

	.result-card-swap-card[data-exited] {
		left: -100%;
	}

	@media (min-width: 1280px) {
		.result-card-swap {
			width: auto;
			max-height: var(--rcs-max-height);
		}

		.result-card-swap-base {
			width: auto;
			height: 100%;
			max-height: var(--rcs-max-height);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.result-card-swap-card {
			transition: none;
		}
	}
</style>

<script>
	for (const el of document.querySelectorAll<HTMLElement>(
		"[data-result-card-swap]",
	)) {
		const cards = Array.from(
			el.querySelectorAll<HTMLElement>(".result-card-swap-card"),
		);
		if (cards.length < 2) continue;

		const intervalMs = Number(el.dataset.interval) || 2800;
		let index = cards.findIndex((c) => c.hasAttribute("data-active"));
		if (index < 0) index = 0;
		let timer: ReturnType<typeof setInterval> | null = null;
		let inView = true;

		// Reset a card that just finished sliding off to the left straight
		// back to its waiting spot on the right, with no visible transition —
		// it's fully hidden behind the clipping window at that point, so the
		// snap itself is invisible, and the card is ready to slide in from
		// the right again next time it's due.
		function resetToWaiting(card: HTMLElement) {
			card.style.transition = "none";
			card.removeAttribute("data-exited");
			void card.offsetWidth;
			card.style.transition = "";
		}

		for (const card of cards) {
			card.addEventListener("transitionend", (e) => {
				if (e.propertyName === "left" && card.hasAttribute("data-exited")) {
					resetToWaiting(card);
				}
			});
		}

		function advance() {
			cards[index].removeAttribute("data-active");
			cards[index].setAttribute("data-exited", "");
			index = (index + 1) % cards.length;
			cards[index].setAttribute("data-active", "");
		}

		function sync() {
			const shouldRun = inView;
			if (shouldRun && !timer) {
				timer = setInterval(advance, intervalMs);
			} else if (!shouldRun && timer) {
				clearInterval(timer);
				timer = null;
			}
		}

		new IntersectionObserver(([entry]) => {
			inView = entry.isIntersecting;
			sync();
		}).observe(el);
	}
</script>

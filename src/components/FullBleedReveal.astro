---
// A full-viewport-width video that sits still while page content scrolls
// away from it and back over it: row above uncovers it, a beat of
// fullscreen hold, then the content below slides up and covers it.
// Desktop gets a 16:9 cut, below the desktop breakpoint a 9:16 cut (two
// <video>s, since <video> has no <picture>-style responsive source).
//
// Or pass `src` alone (no `mobileSrc`) for a single video used at every
// width — e.g. a vertical film: it's fit (never cropped) inside the full-
// viewport stage, so at desktop it runs the full height with bars at the
// sides, coloured `background` (default: the page black).
//
// Or add `device` for a phone recording shown as a device: `src` is a
// full-phone screen recording, sized to a share of the stage's width and
// anchored by its BOTTOM edge, so its top runs off the top of the stage
// (cropped, not a visible frame edge) and its bottom corners are rounded.
// `background` is then a CSS background (e.g. a gradient) that fills the
// whole stage edge to edge, including below the phone.
//
// At desktop a device can instead be cropped to an exact window of the
// recording (`cropTop` / `cropBottom`, fractions of the recording's height):
// the phone is scaled so that window fills the stage's height exactly, so the
// same part of the screen shows at every desktop size, cut straight off at
// the top and bottom (no rounded corners — the phone runs off the stage).
// Takes its numbers from a design reference: the y of the first and last
// visible row of the recording, divided by its height. Mobile is unchanged.
//
// Pure CSS, no scroll JS. Layout (all inside .reveal-wrapper):
//
//   cover        normal flow, opaque, z2   - slot (default)
//   stage        pulled up 100vh over the cover's tail, z1
//     video      position:sticky; top:0; height:100vh
//   exit-cover   pulled up 100vh over the stage's tail, opaque, z2
//                                          - slot="exit-cover"
//
// With C = cover height and H = hold, stage height = 300vh + H:
//   - the stage top sits 100vh above the cover's bottom, so the video
//     sticks at the exact moment the cover's bottom edge reaches the
//     bottom of the viewport; from then on the cover scrolls up over a
//     motionless video, uncovering it from the top down.
//   - the video stays stuck for another H of scroll once the cover has
//     cleared (fullscreen hold)...
//   - ...then the exit-cover, whose top is pulled to the stage's last
//     100vh, rises over it. The stage ends as the exit-cover's top
//     reaches the viewport top, so the video un-sticks only once it is
//     already hidden.
//
// overflow:clip on the wrapper (not hidden — that would create a scroll
// container and silently break sticky) keeps the video visible ONLY inside
// the wrapper's own box. That's what stops it showing above a cover or
// below an exit-cover that is shorter than the viewport, and from painting
// over neighbouring sections (a positioned element always stacks above
// static content). isolation:isolate keeps the z-indexes local.
//
// Requires no ancestor with overflow other than visible/clip (true today:
// html > body > main > .project-theme > article).
//
// Playback is driven by the site's shared autoplay-in-view script
// (data-autoplay-in-view).
interface Props {
  src: string;
  poster?: string;
  // Omit for a single-source reveal (see top of file).
  mobileSrc?: string;
  mobilePoster?: string;
  alt?: string;
  holdVh?: number;
  // CSS background of the stage: the bars around a fit video (single-source
  // mode) or the surface behind the phone (device mode). Any CSS background
  // value works, e.g. a linear-gradient().
  background?: string;
  // A phone recording shown as a device (see top of file); implies single-
  // source.
  device?: boolean;
  // Desktop-only exact crop of a device recording (see top of file): the
  // fractions of its height cut off the top and the bottom.
  cropTop?: number;
  cropBottom?: number;
}

const {
  src,
  poster,
  mobileSrc,
  mobilePoster,
  alt = "",
  holdVh = 60,
  background,
  device = false,
  cropTop,
  cropBottom,
} = Astro.props;

const single = device || !mobileSrc;
const cropped = device && cropTop !== undefined && cropBottom !== undefined;
const wrapperStyle = [
  `--hold: ${holdVh}vh`,
  background && `--reveal-bar: ${background}`,
  cropped && `--crop-top: ${cropTop}`,
  cropped && `--crop-bottom: ${cropBottom}`,
]
  .filter(Boolean)
  .join("; ");
---

<div class:list={["reveal-wrapper", { "reveal-single": single, "reveal-device": device, "reveal-device--crop": cropped }]} style={wrapperStyle}>
	<div class="reveal-cover">
		<slot />
	</div>
	<div class="reveal-stage">
		<div class="pinned-video">
			<div class="reveal-media">
				<video
					class:list={["reveal-video", single ? "reveal-video--single" : "reveal-video--desktop"]}
					src={src}
					poster={poster}
					muted
					loop
					playsinline
					preload="none"
					aria-label={alt}
					data-autoplay-in-view
				/>
				{
					mobileSrc && !device && (
						<video
							class="reveal-video reveal-video--mobile"
							src={mobileSrc}
							poster={mobilePoster}
							muted
							loop
							playsinline
							preload="none"
							aria-label={alt}
							data-autoplay-in-view
						/>
					)
				}
			</div>
		</div>
	</div>
	<div class="exit-cover">
		<slot name="exit-cover" />
	</div>
</div>

<style>
	.reveal-wrapper {
		position: relative;
		isolation: isolate;
		overflow: clip;
		margin-block: var(--space-5);
	}

	/* Opaque, full width (bare div — no .grid class — so it spans the
	   full-bleed page like any other block), above the video. The padding
	   keeps first/last lines of content off the edge where the video is
	   revealed / covered. */
	.reveal-cover,
	.exit-cover {
		position: relative;
		z-index: 2;
		background: var(--color-bg);
	}

	.reveal-cover {
		padding-bottom: var(--space-5);
	}

	.exit-cover {
		margin-top: -100vh;
		padding-top: var(--space-5);
	}

	.reveal-stage {
		position: relative;
		z-index: 1;
		margin-top: -100vh;
		height: calc(300vh + var(--hold));
	}

	.pinned-video {
		position: sticky;
		top: 0;
		height: 100vh;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		overflow: hidden;
		background: var(--reveal-bar, var(--color-bg));
	}

	.reveal-media {
		width: 100%;
		aspect-ratio: 16 / 9;
	}

	@media (max-width: 1279px) {
		.reveal-media {
			aspect-ratio: 9 / 16;
		}
	}

	.reveal-video {
		display: none;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.reveal-video--desktop {
		display: block;
	}

	@media (max-width: 1279px) {
		.reveal-video--desktop {
			display: none;
		}

		.reveal-video--mobile {
			display: block;
		}
	}

	/* Single-source: one video at every width, fit inside the full stage
	   (full height at desktop with bars at the sides) rather than cropped. */
	.reveal-single .reveal-media {
		aspect-ratio: auto;
		height: 100%;
	}

	.reveal-single .reveal-video--single {
		display: block;
		object-fit: contain;
	}

	/* Device: a phone recording sized by width and hung from its bottom edge
	   (top runs off the stage), bottom corners rounded. Desktop shows more
	   of the gradient below the phone's bottom edge than mobile does; the
	   radius is 30px on mobile (same as the carousel frames at that size) and
	   60px at desktop, where the phone is ~5x larger than a carousel frame. */
	.reveal-device {
		--device-width: 81%;
		--device-bottom: 34%;
		--device-radius: 30px;
	}

	@media (min-width: 1280px) {
		.reveal-device {
			--device-width: min(70%, 1400px);
			--device-bottom: 17%;
			--device-radius: 60px;
		}
	}

	.reveal-device .reveal-media {
		position: absolute;
		left: 50%;
		bottom: var(--device-bottom);
		transform: translateX(-50%);
		width: var(--device-width);
		height: auto;
		border-radius: 0 0 var(--device-radius) var(--device-radius);
		overflow: hidden;
	}

	.reveal-device .reveal-video--single {
		height: auto;
		object-fit: fill;
	}

	/* Exact crop (desktop): scale the phone so the window between the two
	   crop fractions is exactly the stage's height, and hang it so that
	   window starts at the stage's top edge. Width follows from the video's
	   own aspect ratio. Straight edges, so no rounding. */
	@media (min-width: 1280px) {
		.reveal-device--crop {
			--phone-h: calc(100vh / (1 - var(--crop-top) - var(--crop-bottom)));
		}

		.reveal-device--crop .reveal-media {
			bottom: auto;
			top: calc(-1 * var(--crop-top) * var(--phone-h));
			/* max-content: an absolutely positioned box otherwise can't be
			   wider than the space to the right of its left:50%. */
			width: max-content;
			height: var(--phone-h);
			border-radius: 0;
		}

		.reveal-device--crop .reveal-video--single {
			width: auto;
			height: 100%;
			object-fit: contain;
		}
	}
</style>

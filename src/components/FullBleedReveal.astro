---
// A full-viewport-width video reveal used as a dramatic pacing beat
// between normal case-study sections. Desktop gets a 16:9 cut edge to
// edge; below the desktop breakpoint it swaps to a vertical 9:16 cut
// instead (two separate <video> elements, since <video> has no
// <picture>-style responsive-source element).
//
// The mechanic: the video sits BEHIND the cover (the children passed
// in — e.g. the row that should "give way" to the video) the whole
// time, pinned fullscreen to the viewport. The cover is opaque and
// normal-flow, so it fully hides the video until the cover scrolls up
// and off screen, uncovering it from the top down. Once uncovered, the
// video holds fullscreen for `holdVh` of extra scroll, then releases so
// the next section in the page can scroll up and cover it the same way.
//
// The pin can only engage once the cover is tall enough to be fully
// covering the viewport on its own — otherwise there's nothing to hide
// the newly-pinned (position:fixed, z-indexed) video behind, and it
// would paint over whatever's still on screen from the PREVIOUS section
// instead. So the engage point is the latest scroll position at which
// the cover still spans the full viewport (cover.top <= 0 and
// cover.bottom >= viewport height) — this requires the cover to be at
// least one viewport tall, true for a real content row here. Release is
// `holdVh` of scroll after the cover's bottom has fully cleared the top
// of the viewport (not from the engage point — the gap between engage
// and "fully cleared" is itself the reveal, not hold time).
//
// Why this needs JS rather than pure CSS: position:sticky only ever
// constrains an element's OWN scroll trajectory (stops it passing a
// threshold) — it can't make an element sit already-in-place, revealed by
// something ELSE scrolling away on top of it. Tried three sticky-only
// approaches first (negative margin on the video, negative margin on the
// cover, CSS Grid overlap) — none engaged at all; verified each with
// direct position sampling across a scroll range before ruling it out.
//
// Two earlier versions of this got the engage point wrong: one measured
// the WRAPPER's bounding box (which includes all the extra space
// budgeted for the hold distance, so its top edge sits well before the
// cover even starts — the video popped fullscreen while the previous
// section was still on screen). The other switched to a non-overlapping
// adjacent-layout model to fix that, which removed the premature-pop bug
// but also removed the occlusion effect entirely (cover and video never
// overlap, so there's nothing to "reveal" — it just reads as the video
// not showing up at all). This version keeps the overlap (video always
// pinned/fullscreen behind the cover within the engage/release window)
// and fixes only the engage timing, anchored to the cover's own rect.
//
// Video playback still only runs while in view, via the site's shared
// autoplay-in-view script (data-autoplay-in-view).
interface Props {
  src: string;
  poster?: string;
  mobileSrc: string;
  mobilePoster?: string;
  alt?: string;
  holdVh?: number;
}

const {
  src,
  poster,
  mobileSrc,
  mobilePoster,
  alt = "",
  holdVh = 60,
} = Astro.props;
---

<div class="reveal-wrapper" style={`--hold: ${holdVh}vh`} data-reveal-wrapper data-hold-vh={holdVh}>
	<div class="reveal-cover">
		<slot />
	</div>
	<div class="pinned-video" data-pinned-video>
		<div class="reveal-media">
			<video
				class="reveal-video reveal-video--desktop"
				src={src}
				poster={poster}
				muted
				loop
				playsinline
				preload="none"
				aria-label={alt}
				data-autoplay-in-view
			/>
			<video
				class="reveal-video reveal-video--mobile"
				src={mobileSrc}
				poster={mobilePoster}
				muted
				loop
				playsinline
				preload="none"
				aria-label={alt}
				data-autoplay-in-view
			/>
		</div>
	</div>
</div>

<style>
	.reveal-wrapper {
		position: relative;
		margin-block: var(--space-5);
		/* Cover's own natural height, plus the hold distance, plus a full
		   extra viewport height. The video's resting position is the
		   wrapper's own bottom edge (see .pinned-video below) — that extra
		   viewport-height is what makes that resting position land exactly
		   at fullscreen when scrollY reaches releaseAt in the script below
		   (coverBottomDoc + hold), instead of falling short by a full
		   viewport, which would show as a visible jump at release. */
		padding-bottom: calc(var(--hold) + 100vh);
	}

	/* Opaque so it fully covers the pinned video underneath until this
	   content scrolls away — matches the page's own background exactly,
	   so there's no visible seam. */
	.reveal-cover {
		position: relative;
		z-index: 2;
		background: var(--color-bg);
	}

	.pinned-video {
		/* left:50%+translateX(-50%) instead of left:0;right:0 — the latter
		   would span only the wrapper's own (grid-constrained) width while
		   position:absolute, and only the full viewport once switched to
		   position:fixed, so the width would visibly jump at the handoff.
		   This centering approach resolves to the same on-screen horizontal
		   center either way, since the wrapper itself is centered in the
		   viewport, so the width stays a consistent 100vw across both
		   states. bottom:0 rests it at the wrapper's own bottom edge —
		   pixel-identical to position:fixed's fullscreen rect at exactly
		   the release scrollY (see the wrapper's padding-bottom comment),
		   which is what makes that handoff seamless. */
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		width: 100vw;
		bottom: 0;
		z-index: 1;
		height: 100vh;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		overflow: hidden;
		background: var(--color-bg);
	}

	/* While JS has decided this should be pinned to the viewport instead
	   of resting at the wrapper's own bottom. */
	.pinned-video.is-fixed {
		position: fixed;
	}

	.reveal-media {
		width: 100%;
		aspect-ratio: 16 / 9;
	}

	@media (max-width: 1279px) {
		.reveal-media {
			aspect-ratio: 9 / 16;
		}
	}

	.reveal-video {
		display: none;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.reveal-video--desktop {
		display: block;
	}

	@media (max-width: 1279px) {
		.reveal-video--desktop {
			display: none;
		}

		.reveal-video--mobile {
			display: block;
		}
	}
</style>

<script>
	const wrappers = document.querySelectorAll<HTMLElement>("[data-reveal-wrapper]");

	if (wrappers.length > 0) {
		const pairs = Array.from(wrappers, (wrapper) => ({
			cover: wrapper.querySelector<HTMLElement>(".reveal-cover")!,
			video: wrapper.querySelector<HTMLElement>("[data-pinned-video]")!,
			holdVh: Number(wrapper.dataset.holdVh) || 0,
		}));

		function update() {
			const vh = window.innerHeight;
			const scrollY = window.scrollY;

			for (const { cover, video, holdVh } of pairs) {
				// Document-coordinate y where the cover's content ends — the
				// one stable anchor everything else is measured against.
				const coverBottomDoc = cover.getBoundingClientRect().bottom + scrollY;
				const holdPx = (holdVh / 100) * vh;

				// Engage at the latest scrollY where the cover (at least one
				// viewport tall) still fully covers the screen on its own:
				// cover.bottom(viewport) === coverBottomDoc - scrollY, and we
				// want that to still be >= vh, so scrollY <= coverBottomDoc -
				// vh. Pinning any later would show the newly-fixed video
				// painting over whatever's still on screen from before this
				// component, since a positioned/z-indexed element always
				// stacks above plain static content regardless of document
				// order.
				const engageAt = coverBottomDoc - vh;
				// Release once the cover has fully scrolled past (its bottom
				// has cleared the top of the viewport, at coverBottomDoc) and
				// held for holdPx beyond that. This is seamless because
				// resting (absolute, bottom:0 of wrapper) is pixel-identical
				// to fixed fullscreen at exactly this scrollY — see the
				// wrapper's padding-bottom comment for why that's true.
				const releaseAt = coverBottomDoc + holdPx;

				const isPinned = scrollY >= engageAt && scrollY < releaseAt;
				video.classList.toggle("is-fixed", isPinned);
			}
		}

		update();
		window.addEventListener("scroll", update, { passive: true });
		window.addEventListener("resize", update);
	}
</script>

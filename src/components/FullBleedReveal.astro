---
// A full-viewport-width video reveal used as a dramatic pacing beat
// between normal case-study sections. Desktop gets a 16:9 cut edge to
// edge; below the desktop breakpoint it swaps to a vertical 9:16 cut
// instead (two separate <video> elements, since <video> has no
// <picture>-style responsive-source element).
//
// The mechanic has three phases, driven by scroll position relative to
// the cover content (the children passed in — e.g. the row that should
// "give way" to the video), not the wrapper's own box:
//   1. Entering — the video rests immediately below the cover in normal
//      document flow (not overlapping it), so as the cover scrolls up and
//      off screen, the video's top edge rises in exact lockstep with the
//      cover's bottom edge, revealing it from the top down.
//   2. Pinned — the instant the cover's bottom edge reaches the top of
//      the viewport, the video is exactly filling the screen; at that
//      precise moment it switches to position:fixed and holds fullscreen
//      for `holdVh` of additional scroll.
//   3. Exiting — releases back to a resting position immediately
//      adjacent to the wrapper's own bottom edge, so the next section in
//      the page (normal content after this component) scrolls up and
//      covers it in the same lockstep way the cover revealed it.
//
// Both handoffs (entering->pinned and pinned->exiting) are calculated to
// land exactly where the resting position is already pixel-identical to
// the fixed position, so there's no jump or flicker either way.
//
// Why this needs JS rather than pure CSS: position:sticky only ever
// constrains an element's OWN scroll trajectory (stops it passing a
// threshold) — it can't make an element sit already-in-place, revealed by
// something ELSE scrolling away on top of it. Tried three sticky-only
// approaches first (negative margin on the video, negative margin on the
// cover, CSS Grid overlap) — none engaged at all; verified each with
// direct position sampling across a scroll range before ruling it out.
//
// An earlier version of this component derived the pin/release points
// from the wrapper's own bounding box rather than the cover's — the
// wrapper's box includes all the extra space budgeted for the pin/hold
// math, so its top edge sits well before the cover even starts, and the
// video would pop fullscreen while the previous section was still on
// screen. Anchoring to the cover's own rect instead makes that
// structurally impossible: the pin can't engage before the cover has
// actually cleared the viewport.
//
// Video playback still only runs while in view, via the site's shared
// autoplay-in-view script (data-autoplay-in-view).
interface Props {
  src: string;
  poster?: string;
  mobileSrc: string;
  mobilePoster?: string;
  alt?: string;
  holdVh?: number;
}

const {
  src,
  poster,
  mobileSrc,
  mobilePoster,
  alt = "",
  holdVh = 60,
} = Astro.props;
---

<div class="reveal-wrapper" style={`--hold: ${holdVh}vh`} data-reveal-wrapper data-hold-vh={holdVh}>
	<div class="reveal-cover">
		<slot />
	</div>
	<div class="pinned-video" data-pinned-video>
		<div class="reveal-media">
			<video
				class="reveal-video reveal-video--desktop"
				src={src}
				poster={poster}
				muted
				loop
				playsinline
				preload="none"
				aria-label={alt}
				data-autoplay-in-view
			/>
			<video
				class="reveal-video reveal-video--mobile"
				src={mobileSrc}
				poster={mobilePoster}
				muted
				loop
				playsinline
				preload="none"
				aria-label={alt}
				data-autoplay-in-view
			/>
		</div>
	</div>
</div>

<style>
	.reveal-wrapper {
		position: relative;
		margin-block: var(--space-5);
		/* Cover's own natural height, plus the hold distance, plus a full
		   extra viewport height. That last viewport-height is what gives the
		   "exiting" resting position room to sit flush with the wrapper's own
		   bottom edge (see the exiting case in the script below) — without
		   it, releasing the pin after a non-zero hold would leave the video
		   short of fullscreen by exactly the hold amount, a visible jump. */
		padding-bottom: calc(var(--hold) + 100vh);
	}

	/* Opaque so it fully covers the pinned video underneath until this
	   content scrolls away — matches the page's own background exactly,
	   so there's no visible seam. */
	.reveal-cover {
		position: relative;
		z-index: 2;
		background: var(--color-bg);
	}

	.pinned-video {
		/* left:50%+translateX(-50%) instead of left:0;right:0 — the latter
		   would span only the wrapper's own (grid-constrained) width while
		   position:absolute, and only the full viewport once switched to
		   position:fixed, so the width would visibly jump at the handoff.
		   This centering approach resolves to the same on-screen horizontal
		   center either way, since the wrapper itself is centered in the
		   viewport, so the width stays a consistent 100vw across both
		   states. `top` is set directly by the script below — it differs
		   for the entering/pinned/exiting phases (see the doc comment
		   above), so there's no static CSS default for it. */
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		width: 100vw;
		z-index: 1;
		height: 100vh;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		overflow: hidden;
		background: var(--color-bg);
	}

	/* While JS has decided this should be pinned to the viewport instead
	   of resting at its current (script-computed) absolute position. */
	.pinned-video.is-fixed {
		position: fixed;
	}

	.reveal-media {
		width: 100%;
		aspect-ratio: 16 / 9;
	}

	@media (max-width: 1279px) {
		.reveal-media {
			aspect-ratio: 9 / 16;
		}
	}

	.reveal-video {
		display: none;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.reveal-video--desktop {
		display: block;
	}

	@media (max-width: 1279px) {
		.reveal-video--desktop {
			display: none;
		}

		.reveal-video--mobile {
			display: block;
		}
	}
</style>

<script>
	const wrappers = document.querySelectorAll<HTMLElement>("[data-reveal-wrapper]");

	if (wrappers.length > 0) {
		const pairs = Array.from(wrappers, (wrapper) => ({
			wrapper,
			cover: wrapper.querySelector<HTMLElement>(".reveal-cover")!,
			video: wrapper.querySelector<HTMLElement>("[data-pinned-video]")!,
			holdVh: Number(wrapper.dataset.holdVh) || 0,
		}));

		function update() {
			const vh = window.innerHeight;
			const scrollY = window.scrollY;

			for (const { cover, video, holdVh } of pairs) {
				// Document-coordinate y where the cover's content ends — the
				// one stable anchor everything else is measured against.
				const coverBottomDoc = cover.getBoundingClientRect().bottom + scrollY;
				const coverHeight = cover.getBoundingClientRect().height;
				const holdPx = (holdVh / 100) * vh;

				// Entering: resting immediately below the cover (wrapper-
				// relative top = coverHeight, since the cover is the
				// wrapper's first child with no gap before it) — this is
				// exactly fullscreen at scrollY === coverBottomDoc.
				// Pinned: fixed, filling the viewport, for holdPx more.
				// Exiting: resting flush with the wrapper's own bottom edge
				// (wrapper-relative top = coverHeight + holdPx + 0, since the
				// wrapper's total height already budgets coverHeight + hold +
				// 100vh) — exactly fullscreen at the release instant, then
				// scrolls away normally, adjacent to whatever comes next.
				const engageAt = coverBottomDoc;
				const releaseAt = engageAt + holdPx;

				const isPinned = scrollY >= engageAt && scrollY < releaseAt;
				video.classList.toggle("is-fixed", isPinned);

				if (isPinned) {
					video.style.top = "0";
				} else if (scrollY < engageAt) {
					video.style.top = `${coverHeight}px`;
				} else {
					video.style.top = `${coverHeight + holdPx}px`;
				}
			}
		}

		update();
		window.addEventListener("scroll", update, { passive: true });
		window.addEventListener("resize", update);
	}
</script>

---
// A full-viewport-width video break in an otherwise contained case study —
// a dramatic pacing beat between normal grid sections. Desktop gets a 16:9
// cut edge to edge; below the desktop breakpoint there's no equivalent
// "full-bleed landscape" moment, so it swaps to a vertical cut instead
// (two separate <video> elements, shown/hidden by breakpoint, since <video>
// has no <picture>-style responsive-source element).
//
// The reveal itself is pure CSS position:sticky, not a fade or a JS-driven
// animation: a 100vh sticky box (video centered inside it via flexbox) sits
// in a wrapper taller than the viewport. Sticking with `top: 0` means it
// only catches once its own top edge would otherwise scroll past the
// viewport's top — i.e. only after the section above has fully cleared,
// not before (a center-via-transform version of this snapped to screen
// center prematurely, overlapping the row above while it was still
// scrolling away). It then holds for the rest of the wrapper's extra
// height (wrapper height = 100vh + however much "hold" scroll distance you
// want) before releasing and letting the next section scroll up to cover
// it, same as it was uncovered. No IntersectionObserver, no opacity
// transition — the physical scroll motion is the whole effect.
//
// Video playback still only runs while in view, via the site's shared
// autoplay-in-view script (data-autoplay-in-view).
interface Props {
  src: string;
  poster?: string;
  mobileSrc: string;
  mobilePoster?: string;
  alt?: string;
}

const { src, poster, mobileSrc, mobilePoster, alt = "" } = Astro.props;
---

<div class="reveal-wrapper">
	<div class="full-bleed-reveal">
		<div class="reveal-media">
			<video
				class="reveal-video reveal-video--desktop"
				src={src}
				poster={poster}
				muted
				loop
				playsinline
				preload="none"
				aria-label={alt}
				data-autoplay-in-view
			/>
			<video
				class="reveal-video reveal-video--mobile"
				src={mobileSrc}
				poster={mobilePoster}
				muted
				loop
				playsinline
				preload="none"
				aria-label={alt}
				data-autoplay-in-view
			/>
		</div>
	</div>
</div>

<style>
	/* 100vh for the sticky box itself, plus however much extra "hold" scroll
	   distance you want on top — total wrapper height, not the hold alone.
	   e.g. 170vh here = 100vh sticky box + a 70vh hold. */
	.reveal-wrapper {
		position: relative;
		height: 170vh;
		margin-block: var(--space-5);
	}

	.full-bleed-reveal {
		position: sticky;
		top: 0;
		height: 100vh;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: var(--color-bg);
	}

	.reveal-media {
		width: 100%;
		aspect-ratio: 16 / 9;
	}

	@media (max-width: 1279px) {
		.reveal-media {
			aspect-ratio: 9 / 16;
		}
	}

	.reveal-video {
		display: none;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.reveal-video--desktop {
		display: block;
	}

	@media (max-width: 1279px) {
		.reveal-video--desktop {
			display: none;
		}

		.reveal-video--mobile {
			display: block;
		}
	}
</style>

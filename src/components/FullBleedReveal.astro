---
// A full-viewport-width video break in an otherwise contained case study —
// a dramatic pacing beat between normal grid sections. Desktop gets a 16:9
// cut edge to edge; below the desktop breakpoint there's no equivalent
// "full-bleed landscape" moment, so it swaps to a vertical cut instead
// (two separate <video> elements, shown/hidden by breakpoint, since <video>
// has no <picture>-style responsive-source element).
//
// The reveal itself is pure CSS position:sticky, not a fade or a JS-driven
// animation: the video sits pinned, vertically centered, inside a wrapper
// much taller than the viewport. The section above scrolls away to uncover
// it, it holds centered while you keep scrolling through the tall wrapper
// (so you can't just scroll straight past it), then once the wrapper's
// scroll range is used up it releases and the next section scrolls up to
// cover it, same as it was uncovered. No IntersectionObserver, no opacity
// transition — the physical scroll motion is the whole effect.
//
// Video playback still only runs while in view, via the site's shared
// autoplay-in-view script (data-autoplay-in-view).
interface Props {
  src: string;
  poster?: string;
  mobileSrc: string;
  mobilePoster?: string;
  alt?: string;
}

const { src, poster, mobileSrc, mobilePoster, alt = "" } = Astro.props;
---

<div class="reveal-wrapper">
	<div class="full-bleed-reveal">
		<video
			class="reveal-video reveal-video--desktop"
			src={src}
			poster={poster}
			muted
			loop
			playsinline
			preload="none"
			aria-label={alt}
			data-autoplay-in-view
		/>
		<video
			class="reveal-video reveal-video--mobile"
			src={mobileSrc}
			poster={mobilePoster}
			muted
			loop
			playsinline
			preload="none"
			aria-label={alt}
			data-autoplay-in-view
		/>
	</div>
</div>

<style>
	/* Taller than the viewport on purpose — this is the scroll distance the
	   video stays pinned for. Tune this to change how long it "holds". */
	.reveal-wrapper {
		position: relative;
		height: 220vh;
		margin-block: var(--space-5);
	}

	.full-bleed-reveal {
		position: sticky;
		top: 50%;
		transform: translateY(-50%);
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--color-bg);
	}

	@media (max-width: 1279px) {
		.full-bleed-reveal {
			aspect-ratio: 9 / 16;
		}
	}

	.reveal-video {
		display: none;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.reveal-video--desktop {
		display: block;
	}

	@media (max-width: 1279px) {
		.reveal-video--desktop {
			display: none;
		}

		.reveal-video--mobile {
			display: block;
		}
	}
</style>

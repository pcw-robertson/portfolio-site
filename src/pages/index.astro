---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectStack from "../components/ProjectStack.astro";

const site = (await getEntry("site", "index"))!.data;
---

<BaseLayout title={`${site.name} — ${site.title}`} description={site.positioningStatement}>
	<h1 class="visually-hidden">{site.name}, {site.title}</h1>

	<div class="grid home">
		<div class="col-7 copy intro">
			<p>{site.positioningStatement}</p>
			<p>{site.summary}</p>
		</div>

	</div>

	<ProjectStack label="Selected Work" />
</BaseLayout>

<style>
	.home {
		padding-top: var(--space-4);
	}

	@media (min-width: 1280px) {
		.home {
			/* Figma: copy starts 72px below the nav line. */
			padding-top: 72px;
			row-gap: 20px;
		}
	}

	/* The large section gap from the case study pages (--space-5), less the
	   grid's own row gap that already sits between these rows. */
	.intro {
		margin-bottom: calc(var(--space-5) - var(--grid-gutter));
	}
</style>

---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectStack from "../components/ProjectStack.astro";

const site = (await getEntry("site", "index"))!.data;
---

<BaseLayout title={`${site.name} — ${site.title}`} description={site.positioningStatement}>
	<h1 class="visually-hidden">{site.name}, {site.title}</h1>

	<div class="grid home">
		<div class="col-7 copy intro">
			<p>{site.positioningStatement}</p>
			<p>{site.summary}</p>
		</div>

		<a class="scroll-cue" href="#work" data-scroll-to="work" aria-label="Scroll to selected work">
			<svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
				<path d="M14 4v19M5.5 14.5 14 23l8.5-8.5" stroke="currentColor" stroke-width="1.5" />
			</svg>
		</a>
	</div>

	<ProjectStack label="Selected Work" />
</BaseLayout>

<style>
	/* The intro fills the first screen, less a fixed strip (--home-peek) of
	   the first project, anchored to the bottom of the viewport: the nav, this
	   block and the gap before the stack add up to 100svh - peek, so the same
	   amount of the project shows whatever the screen height. (If the text is
	   taller than that, the block just grows.) */
	.home {
		padding-top: var(--space-4);
		align-content: start;
		min-height: calc(100svh - var(--home-peek) - var(--nav-h) - var(--space-4));
	}

	@media (min-width: 1280px) {
		.home {
			/* Figma: copy starts 72px below the nav line. */
			padding-top: 72px;
			row-gap: 20px;
		}
	}

	/* A quiet down arrow under the intro: says "keep scrolling" (the area
	   below reads like a button otherwise) and scrolls to the work when tapped. */
	.scroll-cue {
		grid-column: 1 / -1;
		justify-self: start;
		margin-top: calc(var(--space-4) - var(--grid-gutter));
		color: var(--color-muted);
		line-height: 0;
		animation: cue-bob 2.4s ease-in-out infinite;
	}

	.scroll-cue:hover {
		color: var(--color-ink);
	}

	@keyframes cue-bob {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(6px); }
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-cue {
			animation: none;
		}
	}
</style>

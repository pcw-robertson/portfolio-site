---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const site = (await getEntry("site", "index"))!.data;
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={`${site.name} — ${site.title}`}>
	<h1 class="visually-hidden">{site.name}, {site.title}</h1>

	<div class="grid home">
		<div class="col-6 copy intro">
			<p>{site.positioningStatement}</p>
			<p>{site.summary}</p>
		</div>

		<div class="col-12 work-head">
			<hr class="rule" />
			<h2 class="work-label">Selected Work</h2>
		</div>

		{
			projects.map((project) => (
				<div class="col-6 card-cell">
					<ProjectCard project={project} />
				</div>
			))
		}
	</div>
</BaseLayout>

<style>
	.home {
		padding-top: var(--space-4);
	}

	@media (min-width: 1280px) {
		.home {
			/* Figma: copy starts 72px below the nav line. */
			padding-top: 72px;
			row-gap: 20px;
		}
	}

	.intro {
		margin-bottom: 10px;
	}

	.rule {
		margin: 0;
		border: 0;
		border-top: 1px solid var(--color-ink);
	}

	.work-label {
		margin: 23px 0 5px;
		font-size: var(--text-l);
		font-weight: 400;
		line-height: var(--leading-l);
		letter-spacing: normal;
		color: var(--color-ink);
	}

	.card-cell {
		margin-bottom: 12px;
	}
</style>

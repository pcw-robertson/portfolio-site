---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const site = (await getEntry("site", "index"))!.data;
const aboutEntry = (await getEntry("about", "index"))!;
const { Content } = await render(aboutEntry);
---

<BaseLayout title={`About — ${site.name}`}>
	<h1 class="visually-hidden">About</h1>

	<div class="grid about">
		<div class="col-6 copy">
			<Content />
		</div>
	</div>
</BaseLayout>

<style>
	.about {
		padding-top: var(--space-4);
	}

	@media (min-width: 1280px) {
		.about {
			/* Figma: copy starts 72px below the nav line. */
			padding-top: 72px;
		}
	}
</style>

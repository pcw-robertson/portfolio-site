---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const site = (await getEntry("site", "index"))!.data;
const aboutEntry = (await getEntry("about", "index"))!;
const { Content } = await render(aboutEntry);
---

<BaseLayout title={`About — ${site.name}`}>
	<section class="section wrap about">
		<h1>About</h1>
		<Content />
	</section>
</BaseLayout>

<style>
	.about {
		max-width: var(--measure);
	}

	.about h2 {
		margin-top: var(--space-4);
	}
</style>

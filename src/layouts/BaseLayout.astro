---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/grid.css";

interface Props {
  title: string;
  description?: string;
  // Absolute path of a 1200x630 share image. Defaults to the site-wide one
  // (currently a Wired app frame on its gradient — a stand-in).
  image?: string;
}

const { title, description = "", image = "/og-image.jpg" } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imageUrl = image && Astro.site ? new URL(image, Astro.site).href : undefined;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#000000" />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="preload"
			href="/fonts/soehne-buch.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		{description && <meta name="description" content={description} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Peter Robertson" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		{canonical && <meta property="og:url" content={canonical} />}
		{imageUrl && <meta property="og:image" content={imageUrl} />}
		<meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
		<title>{title}</title>
	</head>
	<body>
		<Nav />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

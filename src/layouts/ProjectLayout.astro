---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import ProjectHero from "../components/ProjectHero.astro";
import ProjectWalkthrough from "../components/ProjectWalkthrough.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, context, embedUrl, coverImage, coverVideo, screenshots, template } =
  project.data;

// The walkthrough component only supports 2 or 3 assets side by side; other
// counts are skipped for now rather than falling back to a different layout.
const showWalkthrough = screenshots.length === 2 || screenshots.length === 3;
const isCustom = template === "custom";
---

<BaseLayout title={`${title} — Project`} description={context}>
	<div class="project-theme full-bleed">
		{
			isCustom ? (
				<article class="section">
					<slot />
				</article>
			) : (
				<>
					{(coverVideo || coverImage) && (
						<ProjectHero
							src={coverVideo || coverImage!}
							type={coverVideo ? "video" : "image"}
							poster={coverImage}
						/>
					)}

					<article class="section wrap">
						<header class="project-header">
							<h1>{title}</h1>
							<p class="muted">{context}</p>
						</header>

						{embedUrl && (
							<div class="embed">
								<iframe
									src={embedUrl}
									title={`${title} walkthrough`}
									allow="autoplay; fullscreen; picture-in-picture"
									allowfullscreen
								/>
							</div>
						)}

						<div class="body">
							<slot />
						</div>
					</article>

					{showWalkthrough && (
						<section class="section">
							<ProjectWalkthrough
								assets={screenshots.map((src) => ({ src }))}
							/>
						</section>
					)}
				</>
			)
		}

		<div class="wrap">
			<p class="back"><a href="/">&larr; Back to all work</a></p>
		</div>
	</div>
</BaseLayout>

<style>
	.project-theme {
		--color-bg: #050505;
		--color-ink: #f5f5f2;
		--color-body: #d6d6d3;
		--color-muted: #8f8f8c;
		--color-line: #2b2b29;
		--color-accent: #f5f5f2;
		background: var(--color-bg);
		color: var(--color-body);
	}

	.project-header {
		max-width: var(--measure);
		margin-bottom: var(--space-4);
	}

	.embed {
		position: relative;
		width: 100%;
		padding-top: 56.25%;
		background: var(--color-line);
		margin-bottom: var(--space-4);
	}

	.embed iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.body {
		max-width: var(--measure);
	}

	.body :global(h2),
	.project-theme :global(.grid h2) {
		margin-top: var(--space-4);
	}

	.back {
		padding-top: var(--space-5);
		padding-bottom: var(--space-5);
	}

	.back a {
		text-decoration: none;
		font-weight: 500;
	}

	.back a:hover {
		text-decoration: underline;
	}
</style>

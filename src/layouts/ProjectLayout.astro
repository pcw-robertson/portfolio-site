---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import ProjectHero from "../components/ProjectHero.astro";
import ProjectWalkthrough from "../components/ProjectWalkthrough.astro";

interface Props {
  project: CollectionEntry<"projects">;
  // Prototype: when set, overscrolling past the bottom of the page
  // navigates into this next case study. See [id].astro for how it's
  // computed and which project currently has this switched on.
  nextProject?: { title: string; href: string } | null;
}

const { project, nextProject = null } = Astro.props;
const { title, context, embedUrl, coverImage, coverVideo, screenshots, template } =
  project.data;

// The walkthrough component only supports 2 or 3 assets side by side; other
// counts are skipped for now rather than falling back to a different layout.
const showWalkthrough = screenshots.length === 2 || screenshots.length === 3;
const isCustom = template === "custom";
---

<BaseLayout title={`${title} — Project`} description={context}>
	<div class="project-theme full-bleed">
		{
			isCustom ? (
				<article class="section">
					<slot />
				</article>
			) : (
				<>
					{(coverVideo || coverImage) && (
						<ProjectHero
							src={coverVideo || coverImage!}
							type={coverVideo ? "video" : "image"}
							poster={coverImage}
						/>
					)}

					<article class="section wrap">
						<header class="project-header">
							<h1>{title}</h1>
							<p class="muted">{context}</p>
						</header>

						{embedUrl && (
							<div class="embed">
								<iframe
									src={embedUrl}
									title={`${title} walkthrough`}
									allow="autoplay; fullscreen; picture-in-picture"
									allowfullscreen
								/>
							</div>
						)}

						<div class="body">
							<slot />
						</div>
					</article>

					{showWalkthrough && (
						<section class="section">
							<ProjectWalkthrough
								assets={screenshots.map((src) => ({ src }))}
							/>
						</section>
					)}
				</>
			)
		}

		<div class="wrap">
			<p class="back"><a href="/">&larr; Back to all work</a></p>
		</div>
	</div>

	{nextProject && (
		<div class="scroll-next" data-scroll-next data-next-href={nextProject.href}>
			<p>Keep scrolling for <strong>{nextProject.title}</strong> &rarr;</p>
		</div>
	)}

	{nextProject && (
	<script>
		const hint = document.querySelector<HTMLElement>("[data-scroll-next]");
		if (hint) {
			const href = hint.dataset.nextHref!;
			const THRESHOLD = 220;
			let overscroll = 0;
			let navigating = false;

			const atBottom = () =>
				window.innerHeight + window.scrollY >=
				document.documentElement.scrollHeight - 2;

			const reset = () => {
				overscroll = 0;
				hint.style.setProperty("--progress", "0");
				hint.classList.remove("is-active");
			};

			window.addEventListener(
				"wheel",
				(e) => {
					if (navigating) return;
					if (atBottom() && e.deltaY > 0) {
						overscroll += e.deltaY;
						const progress = Math.min(overscroll / THRESHOLD, 1);
						hint.style.setProperty("--progress", String(progress));
						hint.classList.add("is-active");
						if (overscroll >= THRESHOLD) {
							navigating = true;
							// The View Transitions API can reject with an
							// InvalidStateError if a transition is already
							// settling when this fires — harmless (the
							// navigation itself still completes), but left
							// uncaught it's noisy in the console.
							import("astro:transitions/client")
								.then(({ navigate }) => navigate(href))
								.catch(() => {});
						}
					} else if (!atBottom()) {
						reset();
					}
				},
				{ passive: true },
			);

			// Below the desktop breakpoint there's no wheel event for touch
			// scrolling — approximate the same "keep pulling past the bottom"
			// gesture from touch delta instead.
			let touchStartY = 0;
			window.addEventListener(
				"touchstart",
				(e) => {
					touchStartY = e.touches[0].clientY;
				},
				{ passive: true },
			);
			window.addEventListener(
				"touchmove",
				(e) => {
					if (navigating) return;
					const dy = touchStartY - e.touches[0].clientY;
					touchStartY = e.touches[0].clientY;
					if (atBottom() && dy > 0) {
						overscroll += dy * 3;
						const progress = Math.min(overscroll / THRESHOLD, 1);
						hint.style.setProperty("--progress", String(progress));
						hint.classList.add("is-active");
						if (overscroll >= THRESHOLD) {
							navigating = true;
							import("astro:transitions/client")
								.then(({ navigate }) => navigate(href))
								.catch(() => {});
						}
					} else if (!atBottom()) {
						reset();
					}
				},
				{ passive: true },
			);
		}
	</script>
	)}
</BaseLayout>

<style>
	.project-theme {
		/* True black — matches the captured video footage exactly (sampled as
		   pure black), so there's no visible seam around video edges. */
		--color-bg: #000000;
		--color-ink: #ffffff;
		--color-body: #bababa;
		--color-muted: #bababa;
		--color-line: #2b2b29;
		--color-accent: #ffffff;
		background: var(--color-bg);
		color: var(--color-body);
	}

	/* One type size for all sub-heading + body copy on a project page —
	   "The problem"/"Role"/"Outcome" prose (.body, default template) and a
	   custom .grid layout's headings/paragraphs (Wired, New Yorker Games)
	   render identically, denser than the site's default heading sizes. The
	   only exceptions are the case study's own title (its own bigger .grid h1
	   rule below, or .project-header for the default template) and a
	   .caption-quote, which is intentionally larger.

	   No margin-bottom: a heading sits directly above its paragraph the same
	   way a .caption-title sits directly above its text (title, <br>, text in
	   one block) — zero added gap, just the shared line-height leading, so
	   both read with the same rhythm. */
	.body :global(h2),
	.project-theme :global(.grid h2) {
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.5;
		margin-bottom: 0;
	}

	.body :global(p),
	.project-theme :global(.grid p) {
		font-size: 1rem;
		line-height: 1.5;
	}

	.project-theme :global(.grid h1) {
		font-size: 1.5rem;
		font-weight: 400;
		margin-bottom: 0;
	}

	.project-theme :global(.grid .caption-quote p) {
		font-size: 24px;
		line-height: 32px;
	}

	.project-header {
		max-width: var(--measure);
		margin-bottom: var(--space-4);
	}

	.embed {
		position: relative;
		width: 100%;
		padding-top: 56.25%;
		background: var(--color-line);
		margin-bottom: var(--space-4);
	}

	.embed iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.body {
		max-width: var(--measure);
	}

	.back {
		padding-top: var(--space-5);
		padding-bottom: var(--space-5);
	}

	.back a {
		text-decoration: none;
		font-weight: 500;
	}

	.back a:hover {
		text-decoration: underline;
	}

	/* Prototype: fades in as the user keeps scrolling past the bottom of
	   the page, filling in to telegraph how close the next-project
	   navigation is before it fires. */
	.scroll-next {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 24px 0 32px;
		text-align: center;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.92), transparent);
		opacity: 0;
		transform: translateY(8px);
		transition: opacity 0.2s ease, transform 0.2s ease;
		pointer-events: none;
		z-index: 20;
	}

	.scroll-next.is-active {
		opacity: calc(0.5 + var(--progress, 0) * 0.5);
		transform: translateY(0);
	}

	.scroll-next p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--color-body);
	}

	.scroll-next strong {
		color: var(--color-ink);
		font-weight: 500;
	}
</style>

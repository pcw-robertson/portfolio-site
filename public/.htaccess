# Served by Apache on Bluehost. Ships with every deploy (public/ -> dist/ ->
# public_html). Don't edit the copy on the server: the next deploy replaces it.

# ---------------------------------------------------------------------------
# 404 page (built from src/pages/404.astro)
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# One address for the site: https://peter-robertson.co.uk
# http -> https, and www -> the bare domain, in a single hop. Switched on 6 Oct
# 2026, once AutoSSL had issued a certificate covering both names. (If the
# certificate ever lapses, this makes the whole site show a browser warning.)
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # The certificate-validation folder is left alone, so AutoSSL renewals can
  # always reach it over plain http.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://peter-robertson.co.uk%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------------------
# PASSWORD GATE (must stay AFTER the redirect above: the gate's catch-all
# rule ends rewriting. See public/gate.php for how it works; delete this block to
# take the gate off). Pages and the CV go through gate.php, which checks the
# visitor's cookie and serves the file or shows a password form.
# These stay ungated: the gate itself, the Search Console file, robots.txt,
# icons, the share image, the SSL-validation folder (AutoSSL needs it), and
# the asset folders (so the gate page can load its font; the pages are what's
# being kept private).
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(gate\.php|robots\.txt|favicon\.ico|favicon\.svg|og-image\.jpg|googlebd6dcb4c146e09e2\.html)$ - [L]
  RewriteRule ^\.well-known/ - [L]
  RewriteRule ^(_astro|fonts|images|videos)/ - [L]
  RewriteRule ^ /gate.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# ---------------------------------------------------------------------------
# Caching
#  - /_astro/ files have a content hash in their name, so they never change
#    under the same URL: cache for a year.
#  - Fonts, images and videos: a month (they change rarely, and not by hash).
#  - HTML: always revalidate, so a new deploy shows straight away.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Videos are played from the start in-page; let browsers seek/range-request.
AddType video/mp4 .mp4
AddType font/woff2 .woff2
